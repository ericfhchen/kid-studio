<div class="product-grid">
  <div class="container">
    
    {% assign collection = section.settings.collection | default: collections['frontpage'] %}
    
    {% if collection.products.size > 0 %}
      <div class="product-grid__grid">
        {% for product in collection.products %}
          <div class="product-grid__item{% if forloop.first %} product-grid__item--featured{% endif %}">
            <div class="product-grid__card">
              <div class="product-grid__image-container">
                {% if product.images.size > 0 %}
                  {% for image in product.images %}
                    {% if forloop.parentloop.first %}
                    <img
                      src="{{ image | img_url: '1600x' }}"
                      srcset="{{ image | img_url: '800x' }} 800w,
                              {{ image | img_url: '1200x' }} 1200w,
                              {{ image | img_url: '1600x' }} 1600w,
                              {{ image | img_url: '2000x' }} 2000w"
                      sizes="(max-width: 768px) 100vw, 50vw"
                      alt="{{ image.alt | escape }}"
                      class="product-grid__image{% if forloop.first %} product-grid__image--active{% endif %}"
                      loading="eager"{% if forloop.first %} fetchpriority="high"{% endif %}
                    >
                    {% else %}
                    <img
                      src="{{ image | img_url: '800x' }}"
                      srcset="{{ image | img_url: '400x' }} 400w,
                              {{ image | img_url: '600x' }} 600w,
                              {{ image | img_url: '800x' }} 800w,
                              {{ image | img_url: '1200x' }} 1200w"
                      sizes="(max-width: 768px) 100vw, 50vw"
                      alt="{{ image.alt | escape }}"
                      class="product-grid__image{% if forloop.first %} product-grid__image--active{% endif %}"
                      loading="lazy"
                    >
                    {% endif %}
                  {% endfor %}
                  {% if product.images.size > 1 %}
                    <div class="product-grid__nav product-grid__nav--left" aria-label="Previous image"></div>
                    <div class="product-grid__nav product-grid__nav--right" aria-label="Next image"></div>
                  {% endif %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-grid__image product-grid__image--active placeholder-svg' }}
                {% endif %}
              </div>
              
              <div class="product-grid__content">
                {% if forloop.first %}
                  <h2 class="product-grid__product-title">{{ product.title }}</h2>
                  <div class="product-grid__description">{{ product.description }}</div>

                  {% if product.variants.size > 1 %}
                    <div class="product-grid__variants" data-product-id="{{ product.id }}">
                      {% for variant in product.variants %}
                        <button
                          class="product-grid__variant-button{% if forloop.first %} product-grid__variant-button--active{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-variant-price="{{ variant.price }}"
                          data-variant-compare-price="{{ variant.compare_at_price }}"
                          data-variant-image="{{ variant.image | img_url: '1200x' }}">
                          {{ variant.title }}
                        </button>
                      {% endfor %}
                    </div>
                  {% endif %}

                  <div class="product-grid__price">
                    {% if product.compare_at_price > product.price %}
                      <span class="product-grid__price--sale">{{ product.price | money }}</span>
                      <span class="product-grid__price--compare">{{ product.compare_at_price | money }}</span>
                    {% else %}
                      <span>{{ product.price | money }}</span>
                    {% endif %}
                  </div>

                  {% if product.available %}
                    <button class="product-grid__buy-button"
                            data-product-id="{{ product.id }}"
                            data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                      ADD TO CART
                    </button>
                  {% else %}
                    <span class="product-grid__sold-out">SOLD OUT</span>
                  {% endif %}
                {% else %}
                  {% assign cover_type = product.metafields.custom.book_cover_type %}

                  <span class="product-grid__product-title" data-cover-type="{{ cover_type }}">
                    {{ cover_type }}
                  </span>

                  <div class="product-grid__price">
                    {% if product.compare_at_price > product.price %}
                      <span class="product-grid__price--sale">{{ product.price | money }}</span>
                      <span class="product-grid__price--compare">{{ product.compare_at_price | money }}</span>
                    {% else %}
                      <span>{{ product.price | money }}</span>
                    {% endif %}
                  </div>

                  {% if product.available %}
                    <button class="product-grid__buy-button"
                            data-product-id="{{ product.id }}"
                            data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                      ADD TO CART
                    </button>
                  {% else %}
                    <span class="product-grid__sold-out">SOLD OUT</span>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="product-grid__empty">
        <p>No products available.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "category": "Product"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.product-grid {
  padding: 8rem 0;
}

.product-grid__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}

.product-grid__item--featured {
  grid-column: 1 / -1;
  width: 50%;
  margin: 0 auto;
  overflow: visible;
}

.product-grid__card {
  overflow: hidden;
}

.product-grid__image-container {
  position: relative;
  padding-bottom: 100%;
  overflow: hidden;
}

.product-grid__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background-color: #f0f0f0;
  display: none;
}

.product-grid__image--active {
  display: block;
}

.product-grid__nav {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.product-grid__nav--left {
  left: 0;
  cursor: w-resize;
}

.product-grid__nav--right {
  right: 0;
  cursor: e-resize;
}

.product-grid__content {
  font-family: 'Panama Monospace', monospace;
  font-size: 2rem;
  text-align: center;
}

.product-grid__product-title {
  margin-bottom: 10px;
  font-weight: 500;
}

.product-grid__item--featured .product-grid__image-container {
  margin-bottom: 1.5rem;
}

.product-grid__item--featured .product-grid__product-title {
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 1rem;
}

.product-grid__description {
  font-family: Helvetica, sans-serif;
  font-size: 0.75rem;
  font-weight: bold;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  letter-spacing: 0rem;
}

.product-grid__description table {
  margin: 0 auto;
  border-collapse: collapse;
  white-space: nowrap;
  height: auto !important;
  width: auto !important;
}

.product-grid__description tr {
  height: auto !important;
}

.product-grid__description th,
.product-grid__description td {
  border: 1px solid #000;
  padding: 0.25rem 0.4rem;
  font-size: 0.75rem;
  font-weight: bold;
  line-height: 1.1;
  height: auto !important;
  width: auto !important;
}

.product-grid__sizing-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-family: Helvetica, sans-serif;
  font-size: 0.75rem;
  font-weight: bold;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
  margin: 0.75rem 0 0.25rem;
}

.product-grid__sizing-toggle .chevron {
  display: inline-block;
  transition: transform 0.2s;
}

.product-grid__sizing-toggle--open .chevron {
  transform: rotate(180deg);
}

.product-grid__sizing-content {
  display: none;
  margin-top: 0.25rem;
}

.product-grid__sizing-content--open {
  display: block;
}

.product-grid__variants {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-top: 2rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.product-grid__variant-button {
  font-family: 'Panama Monospace', monospace;
  font-size: 1rem;
  font-weight: bold;
  padding: 0.5rem 0.6rem 0.35rem;
  border: 2px solid #000;
  background: none;
  cursor: pointer;
  width: 3.5rem;
  text-align: center;
}

.product-grid__variant-button--active {
  background: #000;
  color: #fff;
}

.product-grid__price {
  margin-bottom: 2rem;
  font-weight: 600;
}

.product-grid__price--sale {
  color: #e53e3e;
  margin-right: 8px;
}

.product-grid__price--compare {
  text-decoration: line-through;
  color: #888;
  font-weight: normal;
}

.product-grid__buy-button {
  display: block;
  width: auto;
  margin: 0 auto;
  color: #000000;
  background: none;
  border: none;
  font-weight: bold;
  cursor: pointer;
  font-size: 2rem;
  font-family: Helvetica, sans-serif;
}

.product-grid__buy-button:hover {
  animation: blink 0.1s linear infinite;
}

.product-grid__sold-out {
  display: block;
  width: auto;
  margin: 0 auto;
  text-align: center;
  color: #999999;
  font-weight: bold;
  font-size: 2rem;
  font-family: Helvetica, sans-serif;
}

.cart__item-details {
  margin-top: 0.25rem;
}

.cart__item-variant {
  font-size: 0.75rem;
  color: #000;
  margin: 0;
}

.product-grid__empty {
  text-align: center;
  padding: 40px;
  background-color: #f8f8f8;
  border-radius: 8px;
}

@media (max-width: 768px) {
  .product-grid {
    padding: 4rem 0;
  }
  
  .product-grid__content {
    font-size: 1.5rem;
  }

  .product-grid__price {
    margin-bottom: 1rem;
  }

  .product-grid__buy-button,
  .product-grid__sold-out {
    font-size: 1.5rem;
  }
  
  .product-grid__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .product-grid__item--featured {
    width: 100%;
    max-width: 100%;
  }

  .product-grid__item--featured .product-grid__product-title {
    font-size: 1.5rem;
  }

  .product-grid__description {
    overflow-x: auto;
  }

  .product-grid__variants {
    flex-wrap: nowrap;
    gap: 6px;
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  var desc = document.querySelector('.product-grid__description');
  if (desc) {
    var table = desc.querySelector('table');
    if (table) {
      var toggle = document.createElement('button');
      toggle.className = 'product-grid__sizing-toggle';
      toggle.innerHTML = 'SIZING <span class="chevron">&#9662;</span>';
      var content = document.createElement('div');
      content.className = 'product-grid__sizing-content';
      table.parentNode.insertBefore(toggle, table);
      content.appendChild(table);
      toggle.after(content);
      toggle.addEventListener('click', function() {
        toggle.classList.toggle('product-grid__sizing-toggle--open');
        content.classList.toggle('product-grid__sizing-content--open');
      });
    }
  }

  document.addEventListener('click', function(e) {
    var nav = e.target.closest('.product-grid__nav');
    if (!nav) return;
    var container = nav.closest('.product-grid__image-container');
    var images = container.querySelectorAll('.product-grid__image');
    var current = container.querySelector('.product-grid__image--active');
    var index = Array.prototype.indexOf.call(images, current);

    current.classList.remove('product-grid__image--active');
    if (nav.classList.contains('product-grid__nav--right')) {
      images[(index + 1) % images.length].classList.add('product-grid__image--active');
    } else {
      images[(index - 1 + images.length) % images.length].classList.add('product-grid__image--active');
    }
  });

  var variantContainer = document.querySelector('.product-grid__variants');
  if (variantContainer) {
    var featuredItem = document.querySelector('.product-grid__item--featured');
    var buyButton = featuredItem.querySelector('.product-grid__buy-button');
    var priceContainer = featuredItem.querySelector('.product-grid__price');

    variantContainer.querySelectorAll('.product-grid__variant-button').forEach(function(btn) {
      btn.addEventListener('click', function() {
        variantContainer.querySelector('.product-grid__variant-button--active').classList.remove('product-grid__variant-button--active');
        btn.classList.add('product-grid__variant-button--active');

        buyButton.dataset.variantId = btn.dataset.variantId;

        var price = parseInt(btn.dataset.variantPrice);
        var comparePrice = parseInt(btn.dataset.variantComparePrice);
        if (comparePrice > price) {
          priceContainer.innerHTML = '<span class="product-grid__price--sale">' + formatMoney(price) + '</span><span class="product-grid__price--compare">' + formatMoney(comparePrice) + '</span>';
        } else {
          priceContainer.innerHTML = '<span>' + formatMoney(price) + '</span>';
        }
      });
    });
  }

  document.querySelectorAll('.product-grid__buy-button').forEach(function(button) {
    button.addEventListener('click', function() {
      var variantId = this.dataset.variantId;
      var productElement = this.closest('.product-grid__item');
      var titleElement = productElement.querySelector('.product-grid__product-title');
      var bookCoverType = titleElement ? titleElement.dataset.coverType : '';

      addToCart(variantId, 1, { 'Book Cover Type': bookCoverType })
        .then(function() {
          var cartContainer = document.getElementById('cart-container');
          if (cartContainer && cartContainer.classList.contains('hidden')) {
            cartContainer.classList.remove('hidden');
          }
          return fetch('/cart.js').then(function(r) { return r.json(); });
        })
        .then(function(cart) {
          updateCartUI(cart);
        });
    });
  });
});
{% endjavascript %} 