<div class="spreads-gallery" id="spreads-gallery">
  <div class="spreads-gallery__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="spreads-gallery__item" {{ block.shopify_attributes }}>
          <div class="spreads-gallery__image-container" data-index="{{ forloop.index0 }}">
            {% if block.type == 'image' and block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | img_url: '2000x' }}" 
                srcset="{{ block.settings.image | img_url: '600x' }} 600w,
                        {{ block.settings.image | img_url: '800x' }} 800w,
                        {{ block.settings.image | img_url: '1200x' }} 1200w,
                        {{ block.settings.image | img_url: '1600x' }} 1600w,
                        {{ block.settings.image | img_url: '2000x' }} 2000w,
                        {{ block.settings.image | img_url: '2400x' }} 2400w"
                sizes="(max-width: 768px) 50vw, 
                       (max-width: 1024px) 33.33vw, 
                       (max-width: 1600px) 600px,
                       800px"
                class="spreads-gallery__image"
                loading="lazy"
              >
            {% else %}
              {% assign placeholder_index = forloop.index | modulo: 5 | plus: 1 %}
              <img 
                src="https://via.placeholder.com/2000x1333/eeeeee/999999?text=Placeholder+Image+{{ placeholder_index }}" 
                alt="Placeholder image {{ placeholder_index }}"
                class="spreads-gallery__image"
                loading="lazy"
              >
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% comment %} Show placeholder images when no blocks have been added {% endcomment %}
      {% for i in (1..12) %}
        <div class="spreads-gallery__item">
          <div class="spreads-gallery__image-container" data-index="{{ forloop.index0 }}">
            <img 
              src="https://via.placeholder.com/2000x1333/eeeeee/999999?text=Placeholder+Image+{{ forloop.index }}" 
              alt="Placeholder image {{ forloop.index }}"
              class="spreads-gallery__image"
              loading="lazy"
            >
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

<!-- Lightbox Overlay -->
<div class="spreads-gallery-lightbox" id="spreads-gallery-lightbox">
  <div class="spreads-gallery-lightbox__backdrop">
    <button class="spreads-gallery-lightbox__close" aria-label="Close gallery">CLOSE</button>
</div>
  <div class="spreads-gallery-lightbox__content">
    
    <div class="spreads-gallery-lightbox__image-container">
      <img src="" alt="" class="spreads-gallery-lightbox__image spreads-gallery-lightbox__image--front">
      <img src="" alt="" class="spreads-gallery-lightbox__image spreads-gallery-lightbox__image--back">
      <div class="spreads-gallery-lightbox__navigation">
        <div class="spreads-gallery-lightbox__nav-left" aria-label="Previous image"></div>
        <div class="spreads-gallery-lightbox__nav-right" aria-label="Next image"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Spreads Gallery",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spreads Gallery",
      "category": "Image",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.spreads-gallery {
  width: 100%;
  margin: 0 0 3rem 0;
  padding: 0;
  background-color: #000000;
}

.spreads-gallery__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 3 columns on desktop */
  width: 100%;
  gap: 0; /* No gap between images */
  background-color: #000000;
}

.spreads-gallery__item {
  width: 100%;
  overflow: hidden;
}

.spreads-gallery__image-container {
  position: relative;
  cursor: pointer;
  width: 100%;
  padding-bottom: 66.667%; /* 3:2 aspect ratio (66.667% = 2/3 * 100) */
  overflow: hidden;
}

.spreads-gallery__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background-color: #000;
  transition: transform 0.3s ease;
}

/* Lightbox Styles */
.spreads-gallery-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: none;
}

.spreads-gallery-lightbox.active {
  display: flex;
  justify-content: center;
  align-items: center;
}

.spreads-gallery-lightbox__backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(238,238,238,0.5);
  backdrop-filter: blur(10px);
}

.spreads-gallery-lightbox__content {
  position: relative;
  width: auto;
  max-width: 90%;
  height: auto;
  max-height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.spreads-gallery-lightbox__image-container {
  position: relative;
  max-width: 90vw;
  max-height: 80vh;
  transition: width 0.15s ease, height 0.15s ease;
}

.spreads-gallery-lightbox__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.spreads-gallery-lightbox__image--front {
  z-index: 1;
}

.spreads-gallery-lightbox__image--back {
  z-index: 0;
  visibility: hidden;
}

.spreads-gallery-lightbox__close {
  position: absolute;
  top: 20px;
  right: 20px;
  font-size: 16px;
  font-weight: bold;
  color: #000;
  mix-blend-mode: difference;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 1001;
  font-family: 'Panama Monospace', monospace;
}

.spreads-gallery-lightbox__navigation {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.spreads-gallery-lightbox__nav-left,
.spreads-gallery-lightbox__nav-right {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  cursor: pointer;
  pointer-events: auto;
}

.spreads-gallery-lightbox__nav-left {
  left: 0;
  cursor: w-resize;
}

.spreads-gallery-lightbox__nav-right {
  right: 0;
  cursor: e-resize;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .spreads-gallery__grid {
    grid-template-columns: repeat(2, 1fr); /* 2 columns on mobile */
  }
  
  /* Apply special styling for the last item when there's an odd number */
  .spreads-gallery__grid.odd-count > .spreads-gallery__item:last-child {
    grid-column: 1 / span 2; /* Span both columns */
    max-width: 50%;
    margin: 0 auto; /* Center the item */
    background-color: #000000; /* Black background */
  }
  
  .spreads-gallery-lightbox__content {
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .spreads-gallery-lightbox__image-container {
    width: 100%;
    height: 100%;
  }
  
  .spreads-gallery-lightbox__close {
    top: 10px;
    right: 10px;
    font-size: 16px;
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const galleryItems = document.querySelectorAll('.spreads-gallery__image-container');
  const lightbox = document.getElementById('spreads-gallery-lightbox');
  const lightboxBackdrop = document.querySelector('.spreads-gallery-lightbox__backdrop');
  const lightboxClose = document.querySelector('.spreads-gallery-lightbox__close');
  const navLeft = document.querySelector('.spreads-gallery-lightbox__nav-left');
  const navRight = document.querySelector('.spreads-gallery-lightbox__nav-right');

  const slotA = document.querySelector('.spreads-gallery-lightbox__image--front');
  const slotB = document.querySelector('.spreads-gallery-lightbox__image--back');
  let activeSlot = slotA;
  let inactiveSlot = slotB;

  const imageContainer = document.querySelector('.spreads-gallery-lightbox__image-container');
  const galleryGrid = document.querySelector('.spreads-gallery__grid');
  const itemCount = document.querySelectorAll('.spreads-gallery__item').length;
  if (itemCount % 2 !== 0) {
    galleryGrid.classList.add('odd-count');
  }

  let currentIndex = 0;
  const galleryImages = [];
  const preloadedImages = {};

  const isHighResDevice = window.innerWidth > 1024;

  galleryItems.forEach(function(item) {
    const image = item.querySelector('.spreads-gallery__image');
    const imageUrl = image.src;
    let highResUrl = imageUrl;
    if (isHighResDevice && !imageUrl.includes('placeholder.com')) {
      highResUrl = imageUrl.replace(/(\d+)x(\d*)/, '2400x');
    }
    galleryImages.push({ src: highResUrl, alt: image.alt });
  });

  function preloadImage(index) {
    if (!preloadedImages[index] && galleryImages[index]) {
      preloadedImages[index] = new Image();
      preloadedImages[index].src = galleryImages[index].src;
    }
  }

  function preloadAdjacentImages(index) {
    for (var offset = 1; offset <= 3; offset++) {
      preloadImage((index + offset) % galleryImages.length);
      preloadImage((index - offset + galleryImages.length) % galleryImages.length);
    }
  }

  // Preload all images on page load (fixed 15-image gallery)
  for (var i = 0; i < galleryImages.length; i++) {
    preloadImage(i);
  }

  function swapSlots() {
    inactiveSlot.classList.remove('spreads-gallery-lightbox__image--back');
    inactiveSlot.classList.add('spreads-gallery-lightbox__image--front');
    activeSlot.classList.remove('spreads-gallery-lightbox__image--front');
    activeSlot.classList.add('spreads-gallery-lightbox__image--back');
    var tmp = activeSlot;
    activeSlot = inactiveSlot;
    inactiveSlot = tmp;
  }

  function resizeContainer(img) {
    var nw = img.naturalWidth;
    var nh = img.naturalHeight;
    if (!nw || !nh) return;
    var maxW = window.innerWidth * 0.9;
    var maxH = window.innerHeight * 0.8;
    var scale = Math.min(maxW / nw, maxH / nh);
    imageContainer.style.width = Math.round(nw * scale) + 'px';
    imageContainer.style.height = Math.round(nh * scale) + 'px';
  }

  function setSlotImage(slot, index) {
    slot.src = galleryImages[index].src;
    slot.alt = galleryImages[index].alt || '';
  }

  galleryItems.forEach(function(item) {
    item.addEventListener('click', function() {
      currentIndex = parseInt(this.dataset.index);
      openLightbox(currentIndex);
    });
  });

  lightboxClose.addEventListener('click', closeLightbox);

  navLeft.addEventListener('click', function(e) {
    e.stopPropagation();
    navigateGallery(-1);
  });

  navRight.addEventListener('click', function(e) {
    e.stopPropagation();
    navigateGallery(1);
  });

  lightbox.addEventListener('click', function(e) {
    if (!imageContainer.contains(e.target)) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') navigateGallery(-1);
    else if (e.key === 'ArrowRight') navigateGallery(1);
  });

  function openLightbox(index) {
    if (galleryImages.length === 0) return;
    currentIndex = index;

    setSlotImage(activeSlot, index);
    activeSlot.classList.add('spreads-gallery-lightbox__image--front');
    activeSlot.classList.remove('spreads-gallery-lightbox__image--back');
    inactiveSlot.classList.add('spreads-gallery-lightbox__image--back');
    inactiveSlot.classList.remove('spreads-gallery-lightbox__image--front');

    if (activeSlot.naturalWidth) {
      resizeContainer(activeSlot);
    } else {
      activeSlot.onload = function() { resizeContainer(activeSlot); };
    }

    document.body.style.overflow = 'hidden';
    lightbox.classList.add('active');
    preloadAdjacentImages(index);
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  function navigateGallery(direction) {
    var newIndex = (currentIndex + direction + galleryImages.length) % galleryImages.length;
    currentIndex = newIndex;

    if (preloadedImages[newIndex] && preloadedImages[newIndex].complete) {
      setSlotImage(inactiveSlot, newIndex);
      swapSlots();
      resizeContainer(activeSlot);
    } else {
      if (!preloadedImages[newIndex]) preloadImage(newIndex);
      setSlotImage(inactiveSlot, newIndex);
      inactiveSlot.onload = function() {
        if (currentIndex !== newIndex) return;
        swapSlots();
        resizeContainer(activeSlot);
      };
    }

    preloadAdjacentImages(newIndex);
  }
});
{% endjavascript %} 