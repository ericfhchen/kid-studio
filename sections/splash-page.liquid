{% if settings.enable_splash_page %}
<div class="splash-page" id="splash-page">
  <div class="splash-page__content">
    <h1 class="splash-headline">{{ section.settings.headline }}</h1>
    <p class="splash-subheadline">{{ section.settings.subheadline }}</p>
  </div>
  <p class="splash-credit">{{ section.settings.credit }}</p>
</div>

<style>
  .splash-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    z-index: 2147483647;
    background-color: {{ settings.splash_page_background }};
    display: flex;
    flex-direction: column;
    overflow: hidden;
    user-select: none;
  }

  .splash-page__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 2rem;
  }

  .splash-headline {
    font-family: 'Panama Monospace', monospace;
    font-weight: 700;
    font-size: 8vw;
    line-height: 1;
    color: #1a1a1a;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.5em 0;
    text-align: center;
  }

  .splash-subheadline {
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: #1a1a1a;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .splash-credit {
    text-align: center;
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    color: #1a1a1a;
    padding: 0 1rem 2rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .splash-headline {
      font-size: 10vw;
    }
    .splash-subheadline {
      font-size: 1.125rem;
    }
  }
</style>
{% else %}
<!-- Splash page is disabled, normal content will be shown -->
{% endif %}

{% schema %}
{
  "name": "Splash Page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "GOD BLESS TORONTO"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline / Date",
      "default": "coming soon",
      "info": "Shown below the headline in bold"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Bottom credit",
      "default": "A Decade of Kid. Studio"
    }
  ],
  "presets": [
    {
      "name": "Splash Page",
      "category": "Promotional"
    }
  ]
}
{% endschema %} 