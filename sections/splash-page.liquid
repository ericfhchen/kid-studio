  @keyframes splashFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .splash-headline {
    font-family: 'Panama Monospace', monospace;
    font-weight: 700;
    font-size: 11vw;
    line-height: 1;
    color: #1a1a1a;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.2em 0;
    text-align: center;
    animation: splashFadeIn 0.8s ease 0.2s both;
  }

  .splash-subheadline {
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: #1a1a1a;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0;
    margin: 0;
    animation: splashFadeIn 0.8s ease 0.5s both;
  }

  .splash-credit {
    text-align: center;
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    color: #1a1a1a;
    padding: 0 1rem 2rem;
    margin: 0;
    animation: splashFadeIn 0.8s ease 0.8s both;
  }