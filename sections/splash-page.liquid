{% if settings.enable_splash_page %}
<div class="splash-page" id="splash-page">
  <div class="splash-page__content">
    <h1 class="splash-headline">{{ section.settings.headline }}</h1>
    <p class="splash-subheadline">{{ section.settings.subheadline }}</p>
  </div>
  <p class="splash-credit">{{ section.settings.credit }}</p>
</div>

<style>
  @keyframes splashFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .splash-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    z-index: 2147483647;
    background-color: {{ settings.splash_page_background }};
    display: flex;
    flex-direction: column;
    overflow: hidden;
    user-select: none;
  }

  .splash-page__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 2rem;
  }

  .splash-headline {
    font-family: 'Panama Monospace', monospace;
    font-weight: 700;
    font-size: 11vw;
    line-height: 1;
    color: #1a1a1a;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.2em 0;
    text-align: center;
    opacity: 0;
    animation: splashFadeIn 0.8s ease forwards;
    animation-delay: 0.2s;
  }

  .splash-subheadline {
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    color: #1a1a1a;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0;
    margin: 0;
    opacity: 0;
    animation: splashFadeIn 0.8s ease forwards;
    animation-delay: 0.5s;
  }

  .splash-credit {
    text-align: center;
    font-family: 'Helvetica', Arial, sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    color: #1a1a1a;
    padding: 0 1rem 2rem;
    margin: 0;
    opacity: 0;
    animation: splashFadeIn 0.8s ease forwards;
    animation-delay: 0.8s;
  }

  @media (max-width: 768px) {
    .splash-headline {
      font-size: 16vw;
    }
    .splash-subheadline {
      font-size: 1.125rem;
    }
  }
</style>
{% else %}
<!-- Splash page is disabled, normal content will be shown -->
{% endif %}