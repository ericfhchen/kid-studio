<!DOCTYPE html>
<html lang="{{ shop.locale }}">
<head>
    <!-- WEBSITE BY  -->
    <!-- ,________________________________ -->
    <!-- |  ┌─────────────────────────────┐\-->  
    <!-- |  │  ┌──────┬──────┬────—──┬─────┐│-->
    <!-- |  │  │█████████████████████│ │---||-->
    <!-- |  │  │████╔════════════╗███│ │---||--> 
    <!-- |  │  │████║----LEFT----║███│ │---||-->
    <!-- |  │  │████╚════════════╝███│ │---||-->
    <!-- |  │  │█████████████████████│ │---||-->
    <!-- |  │  └──────┬──────┬────—──┘ │---||-->
    <!-- |  └─────────────────────────────┘|-->
